PLCC44 programmed logic:
-----------------------------------
BOOT.D = ((BQ2.Q & HALT)
	# (BQ2.Q & RESET));

BQ0.D = (!HALT & !RESET);

BQ1.D = ((!BQ0.Q & HALT)
	# (!BQ0.Q & RESET));

BQ2.D = ((BQ1.Q & HALT)
	# (BQ1.Q & RESET));

DTACK = 0;

!EVENRAMSEL = ((!A20 & !A21 & !A22 & !A23 & !AS & BOOT.Q & !UDS & !FC0)
	# (!A20 & !A21 & !A22 & !A23 & !AS & BOOT.Q & !UDS & !FC1)
	# (!A20 & !A21 & !A22 & !A23 & !AS & BOOT.Q & !UDS & !FC2)
	# (!A20 & !A21 & !A22 & !A23 & !AS & BOOT.Q & !UDS & HWRST)
	# (!A19 & !A20 & !A21 & !A22 & !A23 & !AS & BOOT.Q & !UDS));

ODDROMSEL = (LDS
	# AS
	# XXL_49);

EVENROMSEL = ((BOOT.Q & A20)
	# AS
	# XXL_50);

EXPSEL = ((A19 & FC0 & FC1 & FC2 & !HWRST)
	# (!A20 & !A21 & !A22 & !A23)
	# (A21 & A22 & A23)
	# AS);

WR = !RW;

IOSEL = (!A23
	# !A22
	# !A21
	# !A20
	# (A19 & FC0 & FC1 & FC2 & !HWRST));

!ODDRAMSEL = ((!A20 & !A21 & !A22 & !A23 & !AS & BOOT.Q & !LDS & !FC0)
	# (!A20 & !A21 & !A22 & !A23 & !AS & BOOT.Q & !LDS & !FC1)
	# (!A20 & !A21 & !A22 & !A23 & !AS & BOOT.Q & !LDS & !FC2)
	# (!A20 & !A21 & !A22 & !A23 & !AS & BOOT.Q & !LDS & HWRST)
	# (!A19 & !A20 & !A21 & !A22 & !A23 & !AS & BOOT.Q & !LDS));

XXL_49 = ((A19 & FC0 & FC1 & FC2 & !HWRST)
	# (!A23 & BOOT.Q)
	# (BOOT.Q & !A22)
	# (BOOT.Q & !A21)
	# (BOOT.Q & A20));

XXL_50 = ((A19 & FC0 & FC1 & FC2 & !HWRST)
	# UDS
	# (!A23 & BOOT.Q)
	# (BOOT.Q & !A22)
	# (BOOT.Q & !A21));

BOOT.C = AS;

BOOT.AR = (!HALT & !RESET);

BQ0.C = AS;

BQ0.AP = (!HALT & !RESET);

BQ1.C = AS;

BQ1.AR = (!HALT & !RESET);

BQ2.C = AS;

BQ2.AR = (!HALT & !RESET);

!DTACK.OE = ((A19 & FC0 & FC1 & FC2 & !HWRST)
	# (EVENRAMSEL & EVENROMSEL & ODDRAMSEL & ODDROMSEL & LGEXP)
	# (EVENRAMSEL & EVENROMSEL & EXPSEL & ODDRAMSEL & ODDROMSEL));


